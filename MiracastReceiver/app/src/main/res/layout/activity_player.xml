<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ui.PlayerActivity">

    <!-- ExoPlayer 视图 -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:use_controller="true"
        app:show_timeout="5000"
        app:controller_layout_id="@layout/custom_player_control"
        app:surface_type="surface_view" />

    <!-- AirPlay 镜像专用 Surface。不要复用 PlayerView 的 Surface，避免 ExoPlayer shutter 黑色遮罩盖住 MediaCodec 输出。 -->
    <SurfaceView
        android:id="@+id/airplay_mirror_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 镜像画面旋转层：旋转角度不为 0 时才显示，解码器改往这块 TextureView 送帧（SurfaceView 不支持旋转内容）。
         黑底盖住下面的 SurfaceView；0° 时隐藏，继续走 SurfaceView 的硬件视频层，电视 4K 性能不受影响。 -->
    <FrameLayout
        android:id="@+id/mirror_rotate_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <TextureView
            android:id="@+id/mirror_rotate_texture"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 图片轮播视图 -->
    <ImageView
        android:id="@+id/image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:background="#000000"
        android:contentDescription="@string/cd_cast_image"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- 顶部状态栏 -->
    <LinearLayout
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#80000000"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/connected"
            android:textColor="@color/success"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            tools:text="播放标题" />

        <!-- 缓冲状态指示器 -->
        <ProgressBar
            android:id="@+id/buffering_indicator"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 视频流信息面板（更多菜单或遥控 INFO 键切换） -->
    <TextView
        android:id="@+id/tv_stream_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_stream_info"
        android:fontFamily="monospace"
        android:lineSpacingExtra="4dp"
        android:padding="16dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:visibility="gone"
        tools:text="视频信息\n分辨率  1920x1080"
        tools:visibility="visible" />

    <!-- 手动旋转浮动按钮：镜像/Miracast/图片模式用（没有控制条）。点屏幕或按遥控器 OK/上下键呼出，几秒后自动隐藏 -->
    <ImageButton
        android:id="@+id/btn_rotate_overlay"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_rotate_button"
        android:focusable="true"
        android:contentDescription="@string/cd_rotate_screen"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_rotate"
        android:visibility="gone" />

    <!-- 加载指示器 -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent"
        android:visibility="visible" />

    <!-- 错误提示 -->
    <TextView
        android:id="@+id/tv_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="24dp"
        android:textColor="@color/error"
        android:textSize="28sp"
        android:visibility="gone"
        tools:text="播放错误" />

</FrameLayout>
