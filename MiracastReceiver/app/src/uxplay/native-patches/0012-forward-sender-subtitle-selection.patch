+    if (!strcmp(property, "selectedMediaArray")) {
+        int request_datalen = 0;
+        const char *request_data = http_request_get_data(request, &request_datalen);
+        plist_t root = NULL;
+        if (!request_data || request_datalen <= 0) goto post_error;
+        plist_from_bin(request_data, request_datalen, &root);
+        plist_t value = root ? plist_dict_get_item(root, "value") : NULL;
+        if (!value || !PLIST_IS_ARRAY(value)) {
+            if (root) plist_free(root);
+            goto post_error;
+        }
+        airplay_video_t *video = raop->current_video >= 0 ? hls_get_current_video(raop) : NULL;
+        for (uint32_t i = 0; i < plist_array_get_size(value); ++i) {
+            plist_t item = plist_array_get_item(value, i);
+            if (!item || !PLIST_IS_DICT(item)) continue;
+            char *type = NULL, *language = NULL, *name = NULL;
+            plist_t node = plist_dict_get_item(item, "MediaSelectionGroupMediaType");
+            if (!PLIST_IS_STRING(node)) node = plist_dict_get_item(item, "MediaSelectionOptionsMediaType");
+            if (PLIST_IS_STRING(node)) plist_get_string_val(node, &type);
+            node = plist_dict_get_item(item, "MediaSelectionOptionsExtendedLanguageTag");
+            if (!PLIST_IS_STRING(node)) node = plist_dict_get_item(item, "MediaSelectionOptionsUnicodeLanguageIdentifier");
+            if (!PLIST_IS_STRING(node)) node = plist_dict_get_item(item, "MediaSelectionOptionsUnicodeLanguageCode");
+            if (PLIST_IS_STRING(node)) plist_get_string_val(node, &language);
+            node = plist_dict_get_item(item, "MediaSelectionOptionsName");
+            if (PLIST_IS_STRING(node)) plist_get_string_val(node, &name);
+            if (type && (!strcmp(type, "sbtl") || !strcmp(type, "text") || !strcmp(type, "clcp"))) {
+                bool enabled = (language && language[0]) || (name && name[0]);
+                logger_log(raop->logger, LOGGER_INFO, "Sender subtitle selection: enabled=%d language=%s",
+                           enabled, language ? language : "(none)");
+                if (raop->callbacks.on_video_subtitle)
+                    raop->callbacks.on_video_subtitle(raop->callbacks.cls, language, name, enabled);
+            } else if (video && type && !strcmp(type, "soun")) {
+                if (language) set_language_code(video, language, strlen(language));
+                if (name) set_language_name(video, name, strlen(name));
+            }
+            plist_mem_free(type);
+            plist_mem_free(language);
+            plist_mem_free(name);
+        }
+        plist_free(root);
+        http_response_add_header(response, "Content-Length", "0");
